DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
REDIS_URL=redis://localhost:6380/0

# Google AI Studio key for Gemini. Get one at https://aistudio.google.com/.
# Required for the /chat endpoint and all agent tests. Without it, the backend
# starts and ingestion works, but /chat requests fail at LLM call time.
GOOGLE_API_KEY=

# Phase 8 — Clerk IdP. Create a Clerk app at https://dashboard.clerk.com and
# copy the Frontend API URL (issuer) + its JWKS endpoint here. JWKS is fetched
# lazily on first authenticated request and cached for the process lifetime.
CLERK_JWKS_URL=
CLERK_ISSUER=

# Dev escape hatch: when DEV_AUTH_BYPASS=1, /chat and /ingest accept any
# Bearer value as the user id without verifying a JWT. Useful for local curl
# smoke testing. The app logs a startup warning when this is enabled.
# NEVER set this in production.
# DEV_AUTH_BYPASS=1
