# Phase 8 — Clerk IdP keys. Create a Clerk app at https://dashboard.clerk.com
# and copy these from your application's API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional — point Clerk's components at /sign-in and /sign-up by default.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Hermetic-test escape hatch. When NEXT_PUBLIC_TEST_DISABLE_AUTH=1 the
# Clerk middleware short-circuits and lets every request through. Combined
# with the backend's DEV_AUTH_BYPASS=1, this lets Playwright run without
# real Clerk credentials. NEVER set in production.
# NEXT_PUBLIC_TEST_DISABLE_AUTH=1
